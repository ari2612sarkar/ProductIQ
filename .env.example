# Product Intelligence - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=product-intelligence
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_intelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Read-only database for SQL agent (create separate user in production)
DATABASE_READONLY_URL=postgresql://readonly:readonly@localhost:5432/product_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Vector Database
VECTOR_DB_TYPE=qdrant  # or pgvector
VECTOR_DB_URL=postgresql://postgres:postgres@localhost:5432/product_intelligence
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=product_feedback
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=10
RAG_RERANK=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Provider (openai or openrouter)
LLM_PROVIDER=openrouter
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# OpenAI (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://your-domain.com
OPENROUTER_X_TITLE=Product Intelligence

# SQL Safety
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS=10000
SQL_ALLOWED_SCHEMAS=public
SQL_FORBIDDEN_KEYWORDS=INSERT,UPDATE,DELETE,DROP,CREATE,ALTER,TRUNCATE,GRANT,REVOKE,COPY,VACUUM,ANALYZE
SQL_MAX_JOINS=10
SQL_MAX_SUBQUERIES=5
SQL_ENABLE_RECURSION=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=20

# API Keys (comma-separated)
API_KEYS=

# Observability
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=product-intelligence
OTEL_SAMPLE_RATE=1.0
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
LOG_FORMAT=json
LOG_PII_FIELDS=email,user_id,ip_address,authorization

# Data Ingestion
HF_DATASET_NAME=kevykibbz/ecommerce-behavior-data-from-multi-category-store_oct-nov_2019
HF_SPLIT=train
HF_STREAMING=true
HF_BATCH_SIZE=10000
UPWORTHY_DATASET_URL=https://osf.io/jd64p/download
DATA_SAMPLE_SIZE=1000000

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_MAX_STEPS=20
AGENT_CONFIDENCE_THRESHOLD=0.7
ORCHESTRATOR_MAX_PARALLEL_AGENTS=3

# Experiment Analysis
EXPERIMENT_MIN_SAMPLE_SIZE=100
EXPERIMENT_SIGNIFICANCE_LEVEL=0.05
EXPERIMENT_MULTIPLE_COMPARISON_CORRECTION=benjamini-hochberg

# Decision Engine
RICE_MAX_EFFORT=100
RICE_MAX_REACH=1000000
RICE_IMPACT_SCALE=3.0

# Evaluation
EVALUATION_ENABLED=true
EVALUATION_SAMPLE_SIZE=100